#include <LiquidCrystal_I2C.h>
#include <AltSoftSerial.h>
#include <TinyGPS++.h>
#include <SoftwareSerial.h>
#include <math.h>
#include <Wire.h>

//I2C LCD address (use i2c-scanner if needed)
LiquidCrystal_I2C lcd(0x27, 16, 2);

//Emergency phone number with country code
const String EMERGENCY_PHONE = "+917024064226";  // Replace with your emergency number

//GSM Module RX pin to Arduino 3
//GSM Module TX pin to Arduino 2
#define rxPin 2
#define txPin 3
SoftwareSerial sim900a(rxPin,txPin);

//GPS Module RX pin to Arduino 9
//GPS Module TX pin to Arduino 8
AltSoftSerial neogps;
TinyGPSPlus gps;

//Variables for SMS and location
String sms_status, sender_number, received_date, msg;
String latitude, longitude;

//Pin Definitions
#define BUZZER 12
#define BUTTON 11
#define ESP_TRIGGER 4  // Pin to trigger ESP32 camera
#define xPin A1
#define yPin A2
#define zPin A3

//Variables for impact detection
int xaxis = 0, yaxis = 0, zaxis = 0;
int deltx = 0, delty = 0, deltz = 0;
int vibration = 2;
int devibrate = 75;
int magnitude = 0;
int sensitivity = 100;  // Adjust this value based on testing
byte updateflag = 0;
boolean impact_detected = false;

//Timing variables
unsigned long time1;
unsigned long impact_time;
unsigned long alert_delay = 30000; // 30 seconds before sending alert

void setup() {
  Serial.begin(9600);
  
  //Initialize GSM
  sim900a.begin(9600);
  
  //Initialize GPS
  neogps.begin(9600);
  
  //Setup pins
  pinMode(BUZZER, OUTPUT);
  pinMode(BUTTON, INPUT_PULLUP);
  pinMode(ESP_TRIGGER, OUTPUT);
  digitalWrite(ESP_TRIGGER, LOW);
  
  //Initialize LCD
  lcd.begin(16, 2);
  lcd.backlight();
  lcd.clear();
  
  //Initialize GSM module
  initGSM();
  
  //Get initial accelerometer readings
  xaxis = analogRead(xPin);
  yaxis = analogRead(yPin);
  zaxis = analogRead(zPin);
  
  time1 = micros();
  
  //Display ready message
  lcd.setCursor(0,0);
  lcd.print("System Ready");
  Serial.println("System Ready");
  delay(2000);
  lcd.clear();
}

void loop() {
  //Check for impact every 2ms
  if (micros() - time1 > 1999) Impact();
  
  //If impact detected
  if(updateflag > 0) {
    updateflag = 0;
    Serial.println("Impact detected!!");
    Serial.print("Magnitude: "); 
    Serial.println(magnitude);
    
    //Trigger ESP32 camera
    digitalWrite(ESP_TRIGGER, HIGH);
    delay(300);
    digitalWrite(ESP_TRIGGER, LOW);
    
    //Get GPS location
    getGps();
    
    //Activate buzzer
    digitalWrite(BUZZER, HIGH);
    
    //Set impact flags
    impact_detected = true;
    impact_time = millis();
    
    //Update LCD
    lcd.clear();
    lcd.setCursor(0,0);
    lcd.print("Crash Detected");
    lcd.setCursor(0,1);
    lcd.print("Mag:" + String(magnitude));
  }
  
  //Handle alert timing and sending
  if(impact_detected == true) {
    if(millis() - impact_time >= alert_delay) {
      digitalWrite(BUZZER, LOW);
      makeCall();
      delay(1000);
      sendAlert();
      impact_detected = false;
      impact_time = 0;
      lcd.clear();
      lcd.print("Alert Sent");
      delay(2000);
      lcd.clear();
    }
  }
  
  //Check cancel button
  if(digitalRead(BUTTON) == LOW) {
    delay(200);
    digitalWrite(BUZZER, LOW);
    impact_detected = false;
    impact_time = 0;
    lcd.clear();
    lcd.print("Alert Cancelled");
    delay(2000);
    lcd.clear();
  }
  
  //Handle incoming GSM messages
  while(sim900a.available()) {
    parseData(sim900a.readString());
  }
}

void Impact() {
  time1 = micros();
  
  int oldx = xaxis;
  int oldy = yaxis;
  int oldz = zaxis;
  
  xaxis = analogRead(xPin);
  yaxis = analogRead(yPin);
  zaxis = analogRead(zPin);
  
  vibration--;
  if(vibration < 0) vibration = 0;
  if(vibration > 0) return;
  
  deltx = xaxis - oldx;
  delty = yaxis - oldy;
  deltz = zaxis - oldz;
  
  //Calculate magnitude of impact
  magnitude = sqrt(sq(deltx) + sq(delty) + sq(deltz));
  
  if (magnitude >= sensitivity) {
    updateflag = 1;
    vibration = devibrate;
  }
  else {
    magnitude = 0;
  }
}

void initGSM() {
  sim900a.println("AT");
  delay(1000);
  sim900a.println("ATE1");
  delay(1000);
  sim900a.println("AT+CPIN?");
  delay(1000);
  sim900a.println("AT+CMGF=1");
  delay(1000);
  sim900a.println("AT+CNMI=1,1,0,0,0");
  delay(1000);
}

void getGps() {
  boolean newData = false;
  for (unsigned long start = millis(); millis() - start < 2000;) {
    while (neogps.available()) {
      if (gps.encode(neogps.read())) {
        newData = true;
        break;
      }
    }
  }
  
  if (newData) {
    latitude = String(gps.location.lat(), 6);
    longitude = String(gps.location.lng(), 6);
  }
  else {
    Serial.println("No GPS data available");
    latitude = "";
    longitude = "";
  }
  
  Serial.print("Latitude: "); 
  Serial.println(latitude);
  Serial.print("Longitude: "); 
  Serial.println(longitude);
}

void sendAlert() {
  String sms_data;
  sms_data = "Accident Alert!!\r";
  if(latitude != "" && longitude != "") {
    sms_data += "Location: http://maps.google.com/maps?q=loc:";
    sms_data += latitude + "," + longitude;
  }
  else {
    sms_data += "GPS location not available";
  }
  
  sendSms(sms_data);
}

void makeCall() {
  Serial.println("Calling emergency number...");
  sim900a.println("ATD" + EMERGENCY_PHONE + ";");
  delay(20000);
  sim900a.println("ATH");
  delay(1000);
}

void sendSms(String text) {
  sim900a.print("AT+CMGF=1\r");
  delay(1000);
  sim900a.print("AT+CMGS=\"" + EMERGENCY_PHONE + "\"\r");
  delay(1000);
  sim900a.print(text);
  delay(100);
  sim900a.write(0x1A);
  delay(1000);
  Serial.println("SMS Sent Successfully");
}

void parseData(String buff) {
  Serial.println(buff);
  
  unsigned int len, index;
  index = buff.indexOf("\r");
  buff.remove(0, index+2);
  buff.trim();
  
  if(buff != "OK") {
    index = buff.indexOf(":");
    String cmd = buff.substring(0, index);
    cmd.trim();
    
    buff.remove(0, index+2);
    
    if(cmd == "+CMTI") {
      index = buff.indexOf(",");
      String temp = buff.substring(index+1, buff.length()); 
      temp = "AT+CMGR=" + temp + "\r";
      sim900a.println(temp);
    }
    else if(cmd == "+CMGR") {
      if(buff.indexOf(EMERGENCY_PHONE) > 1) {
        buff.toLowerCase();
        if(buff.indexOf("get gps") > 1) {
          getGps();
          String sms_data;
          sms_data = "GPS Location Data\r";
          if(latitude != "" && longitude != "") {
            sms_data += "http://maps.google.com/maps?q=loc:";
            sms_data += latitude + "," + longitude;
          }
          else {
            sms_data += "GPS location not available";
          }
          
          sendSms(sms_data);
        }
      }
    }
  }
}
